{
  "version": 2,
  "effort_by_complexity": {
    "simple": "low",
    "normal": "medium",
    "complex": "high"
  },
  "roles": {
    "coordinator": {
      "model": "claude-opus-5-5",
      "fallback": {
        "model": "gpt-6.1-sol",
        "effort": "medium"
      }
    },
    "frontend": {
      "runner": "claude",
      "model": "claude-opus-5-5",
      "timeout_minutes": 60,
      "fallback": {
        "runner": "omnigent",
        "model": "gpt-6.1-sol",
        "effort": "medium"
      },
      "claude_transport": "omnigent"
    },
    "backend": {
      "runner": "omnigent",
      "model": "gpt-6.1-sol",
      "timeout_minutes": 60,
      "fallback": {
        "runner": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium",
        "claude_transport": "omnigent"
      }
    },
    "database": {
      "runner": "omnigent",
      "model": "gpt-6.1-sol",
      "timeout_minutes": 60,
      "fallback": {
        "runner": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium",
        "claude_transport": "omnigent"
      }
    },
    "qa": {
      "runner": "omnigent",
      "model": "gpt-6.1-sol",
      "timeout_minutes": 60,
      "fallback": {
        "runner": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium",
        "claude_transport": "omnigent"
      },
      "browser_timeout_minutes": 30
    },
    "reviewer": {
      "model": "claude-opus-5-5",
      "timeout_minutes": 45,
      "fallback": {
        "model": "gpt-6.1-sol",
        "effort": "low"
      }
    },
    "devops": {
      "runner": "omnigent",
      "model": "gpt-6.1-sol",
      "timeout_minutes": 60,
      "fallback": {
        "runner": "claude",
        "model": "claude-opus-5-5",
        "effort": "medium",
        "claude_transport": "omnigent"
      }
    }
  },
  "handoff": {
    "checkout": "project"
  }
}
