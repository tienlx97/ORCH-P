{
  "id": "ORCH-EXAMPLE",
  "status": "proposed",
  "approval": null,
  "base_revision": {
    "be": "<full 40-character BE-P commit SHA>",
    "fe": "<full 40-character FE-P commit SHA>"
  },
  "contract_check": true,
  "sides": {
    "be": {
      "change": "<openspec change slug in BE-P>",
      "objective": "One sentence: the backend outcome",
      "complexity": "complex",
      "model": "<model slug from `codex debug models`>",
      "runner": "omnigent",
      "allowed_paths": [
        "src/**",
        "tests/**",
        "docs/api/**",
        "requests/**",
        "openspec/changes/<slug>/**"
      ],
      "acceptance_criteria": [
        "Observable behavior 1",
        "Tests that prove it"
      ],
      "inputs": [
        "openspec/changes/<slug>/proposal.md"
      ],
      "context": "Optional: the part of the approved spec this side needs (Codex sees only its worktree)",
      "timeout_minutes": 60
    },
    "fe": {
      "change": "<openspec change slug in FE-P>",
      "objective": "One sentence: the frontend outcome",
      "complexity": "normal",
      "model": "claude-opus-5-5",
      "runner": "claude",
      "fallback": {
        "runner": "omnigent",
        "model": "<model slug from `codex debug models`>"
      },
      "allowed_paths": [
        "src/**",
        "openspec/changes/<slug>/**"
      ],
      "acceptance_criteria": [
        "Observable UI behavior",
        "Adapter tests",
        "browser: what the page must show"
      ],
      "browser": {
        "url": "http://127.0.0.1:3101/test-page",
        "start_command": [
          "pnpm",
          "dev",
          "-p",
          "3101",
          "--hostname",
          "127.0.0.1"
        ],
        "test_data_only": true
      },
      "inputs": [
        "BE handoff: docs/api changes and the verified BE commit"
      ],
      "claude_transport": "omnigent",
      "browser_timeout_minutes": 30
    }
  },
  "review_config": {
    "model": "claude-opus-5-5",
    "timeout_minutes": 45,
    "fallback": {
      "model": "gpt-5.6-sol",
      "effort": "high"
    }
  }
}
